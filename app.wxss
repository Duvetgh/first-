page {
  background: #F5F7FA;
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Hiragino Sans GB', 'Segoe UI', sans-serif;
}

.container {
  padding: 16rpx 24rpx 48rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  margin: 24rpx 0 12rpx;
}

.subtle-text {
  color: #6B7280;
  font-size: 26rpx;
}

.primary-btn {
  background: #3B82F6;
  color: #fff;
  border-radius: 999rpx;
  padding: 20rpx 32rpx;
  font-size: 30rpx;
}

.secondary-btn {
  border: 1px solid #3B82F6;
  color: #3B82F6;
  border-radius: 999rpx;
  padding: 18rpx 30rpx;
  font-size: 28rpx;
  background: #E5F0FF;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #E5E7EB;
}

.flex-row {
  display: flex;
  flex-direction: row;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tag {
  background: #E5F0FF;
  color: #3B82F6;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.badge-error {
  background: #FEE2E2;
  color: #EF4444;
}

.badge-success {
  background: #D1FAE5;
  color: #10B981;
}
