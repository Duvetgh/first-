.form-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
}
.form-item text {
  font-size: 26rpx;
  color: #111827;
}
.form-item input,
.form-item textarea,
.picker {
  background: #fff;
  border: 1rpx solid #E5E7EB;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
}
.checkbox {
  flex-direction: row;
  align-items: center;
}
